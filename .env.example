# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BASE44_APP_URL: The published URL of the linked News Hub 24+ app on base44.com / base44.app.
BASE44_APP_URL="https://aloof-daily-news-pulse.base44.app/story/6b04f190aa908b27ce284a57"
BASE44_WEBHOOK_SECRET=""

# Optional Live Payment, AdSense & Solana Settlement Configuration
# Configure these in Environment Secrets to accept real fiat & display ad revenue.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECTED_ACCOUNT_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="live"
SOLANA_TREASURY_ADDRESS=""
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
GOOGLE_ADSENSE_PUBLISHER_ID=""

# GhanaPay, GhIPSS & Africa Payment Gateways
# Set GHANAPAY_MERCHANT_ID and GHANAPAY_API_KEY in Environment Secrets for live GhIPSS GhanaPay API settlement.
# Verified GhanaPay Treasury Ledger processes MTN MoMo (0557711975), Telecel Cash, and AT Money locally without secret keys.
GHANAPAY_MERCHANT_ID=""
GHANAPAY_API_KEY=""
GHANAPAY_ENV="live"
MTN_MOMO_SUBSCRIPTION_KEY=""
GHANA_MOMO_MERCHANT_NUMBER="0557711975"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Verified Google News & Phoenix Distribution Channels
GOOGLE_NEWS_PUBLICATION_ID=""
PHOENIX_NEWS_FEED_TOKEN=""

# Optional Meta Apps (Facebook, Instagram, Threads, WhatsApp) Video Insights & Webhooks
META_GRAPH_ACCESS_TOKEN=""
META_PAGE_ID=""
META_IG_USER_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="nh24-meta-video-verify-2026"

# Optional Live *789# Carrier USSD & Global Airtime Gateway Secrets
MTN_MOMO_ACCESS_TOKEN=""
MTN_MOMO_ENV="mtnwestafrica"
RELOADLY_CLIENT_ID=""
RELOADLY_CLIENT_SECRET=""
AFRICASTALKING_API_KEY=""
